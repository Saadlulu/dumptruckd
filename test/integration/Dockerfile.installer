FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install system deps (what a real server would have)
RUN apt-get update && apt-get install -y \
    curl \
    postgresql \
    postgresql-client \
    mysql-server \
    mysql-client \
    sudo \
    systemctl \
    && rm -rf /var/lib/apt/lists/*

# We need Go to build from source (simulating no release binary available)
RUN curl -sL https://go.dev/dl/go1.23.8.linux-amd64.tar.gz | tar -xz -C /usr/local
ENV PATH="/usr/local/go/bin:/root/go/bin:${PATH}"
ENV GOPATH="/root/go"

# Pre-build dumptruckd so the installer finds it (simulating a release binary)
WORKDIR /app
COPY . .
RUN go mod tidy && go build -o /usr/local/bin/dumptruckd ./cmd/dumptruckd

# Copy installer
COPY install.sh /install.sh
RUN chmod +x /install.sh

# Setup script that starts DBs then runs the installer non-interactively
COPY test/integration/test_installer.sh /test_installer.sh
RUN chmod +x /test_installer.sh

CMD ["/test_installer.sh"]
